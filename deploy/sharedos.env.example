MODEL_NAME=z-ai/glm-5.3-flash
MODEL_FALLBACK_NAME=deepseek/deepseek-v4-flash-0731
MODEL_REQUEST_TIMEOUT_SECONDS=8

SERVICE_BASE_URL=https://modelscope-sharedos-1.tail81043f.ts.net
LEDGER_PATH=/mnt/workspace/sharedos-state/commerce.sqlite3
CHECKPOINT_PATH=/mnt/workspace/sharedos-state/checkpoints.sqlite3
