      },
      "disputed": {
        "title": "Disputed",
        "type": "boolean"
      },
      "end_to_end_latency_ms": {
        "anyOf": [
          {
            "minimum": 0,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "End To End Latency Ms"
      },
      "execution_score": {
        "maximum": 100,
        "minimum": 0,
        "title": "Execution Score",
        "type": "number"
      },
      "evidence_weight": {
        "maximum": 1,
        "minimum": 0,
        "title": "Evidence Weight",
        "type": "number"
      },
      "confidence": {
        "title": "Confidence",
        "type": "string"
      },
      "reputation_eligible": {
