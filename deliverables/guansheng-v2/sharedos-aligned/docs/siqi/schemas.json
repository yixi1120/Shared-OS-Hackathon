        "type": "boolean"
      },
      "credit_settlement": {
        "default": "not_evaluated",
        "title": "Credit Settlement",
        "type": "string",
        "const": "not_evaluated"
      },
      "provenance_counts": {
        "additionalProperties": {
          "type": "integer"
        },
        "title": "Provenance Counts",
        "type": "object"
      },
      "evidence_ids": {
        "items": {
          "type": "string"
        },
        "title": "Evidence Ids",
        "type": "array"
      },
      "risk_flags": {
        "items": {
          "type": "string"
        },
        "title": "Risk Flags",
        "type": "array"
      }
    },
    "required": [
      "task_id",
