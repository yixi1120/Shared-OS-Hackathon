# OpenRouter is OpenAI-compatible, so the model can be swapped without code changes.
MODEL_BASE_URL=https://openrouter.ai/api/v1
MODEL_API_KEY=
MODEL_NAME=z-ai/glm-5.3-flash
MODEL_FALLBACK_NAME=deepseek/deepseek-v4-flash-0731
MODEL_MAX_OUTPUT_TOKENS=800
MODEL_REQUEST_TIMEOUT_SECONDS=45

# Set these after the organizers publish the SharedNet/Arena contract.
ARENA_BASE_URL=
ARENA_API_TOKEN=
AGENT_NODE_ID=

# SharedNet room transport. The organizer's room invite supplies ROOM and TOKEN.
# Never commit real rit_ or sni_ credentials. After join, persist the returned
# member token and last received sequence in a secret/runtime store.
SHAREDNET_BASE_URL=https://www.sharednet.ai
SHAREDNET_ROOM_ID=
SHAREDNET_INVITE_TOKEN=
SHAREDNET_MEMBER_TOKEN=
SHAREDNET_LAST_SEQUENCE=0
SHAREDNET_AGENT_NAME=sharedos-commerce-agent
SHAREDNET_RUNTIME_KIND=codex

# Provisional bearer token for protected seller endpoints. Replace this with the
# organizer-provided A2A authentication mechanism when its contract is published.
SELLER_API_TOKEN=

LEDGER_PATH=./commerce.sqlite3
CHECKPOINT_PATH=./checkpoints.sqlite3
OPERATION_JOURNAL_PATH=./outbound-operations.sqlite3
